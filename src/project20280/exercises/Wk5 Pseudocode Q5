FUNCTION DIAMETER(T)

    // If the tree is empty, there is no path
    IF T.root() IS null THEN
        RETURN 0
    END IF

    // Helper returns both height and diameter for the subtree
    result ← DIAMETER_HELPER(T, T.root())

    // Diameter is the number of nodes on the longest path in the whole tree
    RETURN result.diameter

END FUNCTION


FUNCTION DIAMETER_HELPER(T, p)

    // Base case: empty subtree has height 0 and diameter 0
    IF p IS null THEN
        RETURN (height = 0, diameter = 0)
    END IF

    // Compute results for left and right subtrees
    leftRes  ← DIAMETER_HELPER(T, T.left(p))
    rightRes ← DIAMETER_HELPER(T, T.right(p))

    // Height of the subtree at p is 1 (for p) plus the max child height
    currentHeight ← 1 + MAX(leftRes.height, rightRes.height)

    // The longest path that goes through p uses:
    // left subtree height + right subtree height + 1 for p itself
    pathThroughP ← leftRes.height + rightRes.height + 1

    // The best diameter in this subtree is the maximum of:
    // - best diameter in left subtree
    // - best diameter in right subtree
    // - a path that goes through p
    currentDiameter ← MAX(pathThroughP,
                          leftRes.diameter,
                          rightRes.diameter)

    RETURN (height = currentHeight,
            diameter = currentDiameter)

END FUNCTION